# Copy to .env and adjust. `pnpm dev` loads .env if present; every value below has a working
# local default for Homebrew PostgreSQL 17, so .env is optional for local development.
# Never commit .env. Real secrets live only in the hosting provider's environment settings.

# PostgreSQL connection for the API and the worker.
DATABASE_URL=postgresql:///compromised

# Database used by the pytest suites and the Playwright suite (it is emptied by the tests).
TEST_DATABASE_URL=postgresql:///compromised_test
E2E_DATABASE_URL=postgresql:///compromised_test
# Ports the browser suite starts its own API and web app on.
E2E_API_PORT=8100
E2E_WEB_PORT=3100

# Set to 1 only to build the clearly labelled /preview route with sample data into a production
# build (the browser suite does). `next dev` always includes it; never set it for a real deploy.
SAMPLE_PREVIEW=

# Where the web app's server reaches the API.
API_URL=http://127.0.0.1:8000

# Comma-separated origins allowed by the API's CORS policy.
WEB_ORIGINS=http://localhost:3000

# Identifying user agent the worker sends to every source.
USER_AGENT=Compromised/0.1 (+https://github.com/NikoTsiolas/Compromised.io)

# LLM enrichment (#8): plain-language summaries by Claude Haiku. Leave the key empty to run on
# the rule classifier alone. Set the real key only in the server environment, never in a file
# that is committed.
ANTHROPIC_API_KEY=
# Model calls allowed per UTC day; events beyond it keep their rule-based facts and are enriched
# on a later day.
ENRICHMENT_DAILY_CAP=500

# development | test | production. Test samples refuse to load into production.
ENVIRONMENT=development

# Grouping duplicate coverage into events (defaults chosen from the real samples; see the wiki
# page "Stack and hosting", "Grouping as built"). Headline similarity is pg_trgm similarity()
# between headlines of two sources about the same organization.
GROUPING_HEADLINE_SIMILARITY=0.2
GROUPING_ORGANIZATION_WINDOW_HOURS=72
GROUPING_CVE_WINDOW_DAYS=7
# Show the images publishers put in their own feeds, loaded by the browser straight from the
# publisher with credit (never downloaded or cached by us). Set to off to remove them everywhere.
PUBLISHER_IMAGES=on
